@using System.Text.Json
@{
    ViewData["Title"] = "Business Name Search";
    var result = ViewBag.SearchResult as JsonElement?;
    bool hasResult = result.HasValue;
    bool available = false;
    string message = "";
    
    if (hasResult)
    {
        try {
            available = result.Value.GetProperty("availableData").GetProperty("available").GetBoolean();
            if (!available) {
                var notHasData = result.Value.GetProperty("notHasData").GetProperty("data");
                if (notHasData.GetArrayLength() > 0) {
                    message = notHasData[0].GetProperty("message").GetString();
                }
            }
        } catch {}
    }
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">
            <!-- World-Class Header -->
            <div class="text-center mb-5">
                <span class="badge bg-soft-primary text-primary px-3 py-2 mb-3 rounded-pill fw-700 small uppercase" style="letter-spacing: 0.1em;">
                    Step 01 &bull; Name Clearance
                </span>
                <h1 class="display-6 fw-800 mb-3">Reserve your Business Name</h1>
                <p class="text-muted lead fw-500">Search the official Registrar of Companies (ROC) database to ensure your brand is unique and eligible for registration.</p>
            </div>

            <!-- Enhanced Search Card -->
            <div class="world-class-card p-5 mb-5 overflow-hidden">
                <form asp-action="SearchName" method="post">
                    <div class="search-experience">
                        <label class="premium-label mb-3">Business Name to Search</label>
                        <div class="search-input-group">
                            <i class="bi bi-search search-lead-icon"></i>
                            <input type="text" name="searchText" class="premium-search-input" 
                                   placeholder="e.g. Blue Lagoon Ventures" 
                                   value="@ViewBag.SearchText" required autocomplete="off" />
                            <button type="submit" class="btn-premium search-btn">
                                <span class="d-none d-md-inline">Check Availability</span>
                                <i class="bi bi-arrow-right ms-md-2 mt-1"></i>
                            </button>
                        </div>
                    </div>
                    
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert-premium-error mt-4 anim-slide-up">
                            <i class="bi bi-info-circle-fill me-2"></i> @ViewBag.Error
                        </div>
                    }
                </form>
            </div>

            <!-- Results Section -->
            @if (hasResult)
            {
                var availableData = result.Value.GetProperty("availableData");
                var notHasData = result.Value.GetProperty("notHasData");
                
                bool canProceed = notHasData.GetProperty("available").GetBoolean();
                var similarNames = availableData.GetProperty("data");
                var warnings = notHasData.GetProperty("data");

                <div class="anim-slide-up">
                    <!-- Status Command Center Card -->
                    <div class="world-class-card p-5 mb-4 position-relative">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                @if (canProceed)
                                {
                                    <div class="status-indicator success mb-4">
                                        <i class="bi bi-check-circle-fill me-2"></i> NAME IS ELIGIBLE
                                    </div>
                                    <h2 class="display-6 fw-800 mb-2" style="color: #1d1d1f;">@ViewBag.SearchText.ToUpper()</h2>
                                    <p class="text-muted mb-0">This name complies with ROC guidelines and is available for reservation.</p>
                                }
                                else
                                {
                                    <div class="status-indicator danger mb-4">
                                        <i class="bi bi-x-circle-fill me-2"></i> NAME INELIGIBLE
                                    </div>
                                    <h2 class="display-6 fw-800 mb-2 text-danger">@ViewBag.SearchText.ToUpper()</h2>
                                    <p class="text-muted mb-0">Conflict detected with existing entities or regulatory guidelines.</p>
                                }
                            </div>
                            <div class="col-md-4 text-md-end mt-4 mt-md-0">
                                @if (canProceed)
                                {
                                    <a asp-action="ReserveName" asp-route-name="@ViewBag.SearchText" class="btn btn-premium btn-lg px-5 py-3 fw-800 shadow-accent d-inline-flex align-items-center justify-content-center">
                                        Proceed <i class="bi bi-chevron-right ms-2"></i>
                                    </a>
                                }
                                else
                                {
                                    <a href="#SearchName" class="btn btn-outline-secondary btn-lg px-5 py-3 fw-800 rounded-pill">
                                        Try Another
                                    </a>
                                }
                            </div>
                        </div>

                        @if (warnings.GetArrayLength() > 0)
                        {
                            var filteredWarnings = warnings.EnumerateArray()
                                .Where(w => {
                                    var msg = w.GetProperty("message").GetString() ?? "";
                                    if (similarNames.GetArrayLength() == 0) {
                                        if (msg.Contains("Phonetically similar", StringComparison.OrdinalIgnoreCase)) return false;
                                        if (msg.Contains("digits together", StringComparison.OrdinalIgnoreCase)) return false;
                                    }
                                    return true;
                                }).ToList();

                            if (filteredWarnings.Any())
                            {
                                <div class="premium-warnings mt-5 p-4 rounded-4" style="background: rgba(239, 68, 68, 0.05); border-left: 4px solid var(--brand-danger);">
                                    <h5 class="small fw-800 text-danger uppercase mb-3" style="letter-spacing: 0.1em;">Compliance Notices</h5>
                                    @foreach (var warning in filteredWarnings)
                                    {
                                        <div class="d-flex mb-2 small fw-600 text-danger opacity-75">
                                            <i class="bi bi-dot me-1 fs-4 lh-1"></i>
                                            @warning.GetProperty("message").GetString()
                                        </div>
                                    }
                                    @if (canProceed)
                                    {
                                        <div class="mt-3 fs-6 p-2 rounded-3 bg-white border border-danger border-opacity-10 text-center fw-700 text-danger small">
                                            <i class="bi bi-shield-check me-2"></i> You may still proceed, but further scrutiny may apply.
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <!-- Conflict Intelligence List -->
                    @if (similarNames.GetArrayLength() > 0)
                    {
                        <div class="world-class-card p-0 overflow-hidden">
                            <div class="p-4 border-bottom bg-light bg-opacity-50">
                                <h4 class="small fw-800 text-muted uppercase mb-0" style="letter-spacing: 0.1em;">
                                    <i class="bi bi-search me-2"></i> Phonetic Conflict Intelligence (@similarNames.GetArrayLength() found)
                                </h4>
                            </div>
                            <div class="similar-entities">
                                @foreach (var company in similarNames.EnumerateArray())
                                {
                                    <div class="entity-row p-4 d-flex justify-content-between align-items-center border-bottom transition-all">
                                        <div>
                                            <div class="fw-800 mb-1" style="color: #1d1d1f;">@company.GetProperty("name").GetString()</div>
                                            <div class="smaller text-muted fw-600">REGISTRATION NO: @company.GetProperty("registration_no").GetString()</div>
                                        </div>
                                        <i class="bi bi-building text-muted opacity-25 fs-4"></i>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>



